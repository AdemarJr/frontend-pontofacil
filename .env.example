# URL da API (sem barra no final do host; inclua /api se for o caso)
REACT_APP_API_URL=http://localhost:3001/api

# URL pública do site (landing, canonical, Open Graph)
REACT_APP_SITE_URL=http://localhost:3000

# Supabase (opcional — se usar auth/recuperação via Supabase no frontend)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=
